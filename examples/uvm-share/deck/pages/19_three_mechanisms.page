      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">class A extends uvm_callback;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">  virtual function bit gen_tran(); endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">  virtual task run(my_driver drv, uvm_phase phase);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">    phase.raise_objection(drv);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">    while (gen_tran()) drv.drive_one_pkt(tr);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">    phase.drop_objection(drv);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">  endtask</span></p><p style=\"line-height:1.3\"><span style=\"font-size:7.6px;color:#23405A\">endclass</span></p>",
        "align": [
          "left",
          "top"
        ]
      }
