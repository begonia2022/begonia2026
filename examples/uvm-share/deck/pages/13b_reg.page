      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">class my_driver;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">  typedef registry#(my_driver,\"my_driver\") this_type; // 表项存类型+类名</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#17754E\">  local static this_type me = get();                  // 静态登记一次</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">  static function this_type get();</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">    me=new(); global_tab[me.name]=me; return me; endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">endclass</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">function uvm_component create_component_by_name(string name);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">  registry#(uvm_object,\"\") me_ptr;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#17754E\">  me_ptr = global_tab[name];  // ① 查表</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#17754E\">  me_ptr.inst = new();        // ② new</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">  return me_ptr.inst;         // ③ 返回</span></p><p style=\"line-height:1.3\"><span style=\"font-size:15.7px;color:#23405A\">endfunction</span></p>",
        "align": [
          "left",
          "top"
        ]
