      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">class new_driver extends my_driver;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  `uvm_component_utils(new_driver)</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#17754E\">  `uvm_set_super_type(new_driver, my_driver)</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">endclass</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\"></span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">task new_driver::main_phase(uvm_phase phase);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  ...</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#17754E\">  `uvm_do_callbacks(my_driver, A, pre_tran(this, req))</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#8296AA\">  // 注意：第一个参数仍写父类 my_driver</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">endtask</span></p>",
