      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">function void chip_env::build_phase(...);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  env_A = my_env::type_id::create(\"env_A\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  env_B = my_env::type_id::create(\"env_B\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  env_B.in_chip = 1;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  env_C = my_env::type_id::create(\"env_C\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  env_C.in_chip = 1;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  chip_rm = chip_reg_model::type_id::create(\"chip_rm\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  chip_rm.configure(null, \"\");</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  chip_rm.build();</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  chip_rm.lock_model();</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  chip_rm.reset();</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">  reg_sqr_adapter = new(\"reg_sqr_adapter\");</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#8296AA\">  env_A.p_rm = this.chip_rm.A_rm;  // 分下去</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#8296AA\">  env_B.p_rm = this.chip_rm.B_rm;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#8296AA\">  env_C.p_rm = this.chip_rm.C_rm;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.3px;color:#23405A\">endfunction</span></p>",
