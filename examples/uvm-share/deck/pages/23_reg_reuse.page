      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#8296AA\">// ✗ 别在 env 里 new rm：偏移地址会被定死</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">class my_env extends uvm_env;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  reg_model rm;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  virtual function void build_phase(...);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">    rm = reg_model::type_id::create(\"rm\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">endclass</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\"></span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#8296AA\">// ✓ 芯片级：一个块挂住三个模块的 map</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">class chip_reg_model extends uvm_reg_block;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  rand reg_model A_rm, B_rm, C_rm;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  virtual function void build();</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">    default_map = create_map(\"default_map\", 0, 2, UVM_BIG_ENDIAN, 0);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">    default_map.add_submap(A_rm.default_map, 16'h0);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">    default_map.add_submap(B_rm.default_map, 16'h4000);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">    default_map.add_submap(C_rm.default_map, 16'h8000);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:8.2px;color:#23405A\">endclass</span></p>",
