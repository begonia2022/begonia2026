      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">class crc_driver extends my_driver;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  `uvm_component_utils(crc_driver)</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  virtual function void inject_crc_err(my_transaction tr);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">    tr.crc = $urandom_range(10000000, 0);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  virtual task main_phase(uvm_phase phase);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">    ...  seq_item_port.get_next_item(req);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#17754E\">    inject_crc_err(req);        // 发送前篡改</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">    drive_one_pkt(req);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">  endtask</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.9px;color:#23405A\">endclass</span></p>",
