      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">class my_env extends uvm_env;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">  bit in_chip;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">  uvm_analysis_port#(my_transaction) ap;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">  uvm_analysis_export#(my_transaction) i_export;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">  virtual function void build_phase(...);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">    super.build_phase(phase);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#8296AA\">    if(!in_chip) begin  // 芯片级不造 i_agt</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">      i_agt = my_agent::type_id::create(\"i_agt\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">      i_agt.is_active = UVM_ACTIVE;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">    end</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">    if(in_chip) i_export = new(\"i_export\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#8296AA\">  // connect_phase: ap = o_agt.ap</span></p><p style=\"line-height:1.3\"><span style=\"font-size:9.8px;color:#8296AA\">  //   in_chip ? i_export.connect(...) : i_agt.ap.connect(...)</span></p>",
        "align": [
          "left",
          "top"
        ]
