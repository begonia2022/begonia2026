        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">class chip_env extends uvm_env;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">  `uvm_component_utils(chip_env)</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">  my_env env_A, env_B, env_C;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">  virtual function void build_phase(...);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">    env_A = my_env::type_id::create(\"env_A\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">    env_B = my_env::type_id::create(\"env_B\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#8296AA\">    env_B.in_chip = 1;  // B/C 只收数据，不造 i_agt</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">    env_C = my_env::type_id::create(\"env_C\", this);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">    env_C.in_chip = 1;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#8296AA\">  // connect_phase:</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#8296AA\">  //   env_A.ap.connect(env_B.i_export);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.1px;color:#8296AA\">  //   env_B.ap.connect(env_C.i_export);</span></p>",
