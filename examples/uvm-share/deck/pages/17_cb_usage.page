        "text": "<p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">⑤ 派生并重载</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">class my_callback extends A;</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">  virtual task pre_tran(my_driver drv, ref my_transaction tr);</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#7A8A9E\">    // 你的动作</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">  endtask</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">  `uvm_object_utils(my_callback)</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">endclass</span></p><p style=\"margin-top:8px; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">⑥ connect_phase 里挂到池子上</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">my_cb = my_callback::type_id::create(\"my_cb\");</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#2E8CA6;font-weight:700\">A_pool::add(env.i_agt.drv, my_cb);</span></p>",
