      ],
      "content": {
        "text": "<p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">① 定义回调类（必须派生 uvm_callback，任务必须 virtual）</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">class A extends uvm_callback;</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">  virtual task pre_tran(my_driver drv, ref my_transaction tr);</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">endclass</span></p><p style=\"margin-top:8px; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">② 声明池子</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#44586F\">typedef uvm_callbacks#(my_driver, A) A_pool;</span></p><p style=\"margin-top:8px; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">③ 在 driver 里登记</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#2E8CA6;font-weight:700\">`uvm_register_cb(my_driver, A)</span></p><p style=\"margin-top:8px; line-height:1.2\"><span style=\"font-size:11.7px;color:#10263D;font-weight:700\">④ 在要挂钩子的地方触发</span></p><p style=\"margin-top:Nonepx; line-height:1.2\"><span style=\"font-size:11.1px;color:#2E8CA6;font-weight:700\">`uvm_do_callbacks(my_driver, A, pre_tran(this, req))</span></p>",
        "align": [
          "left",
          "top"
        ]
      }
    },
