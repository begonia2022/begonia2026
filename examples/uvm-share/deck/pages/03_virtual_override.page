      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">class bird extends uvm_object;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#17754E\">  virtual function void hungry();  // 虚：可重载</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">    $display(\"I am a bird\");</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">  function void hungry2();  // 非虚：不能重载</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">  endfunction</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">endclass</span></p><p style=\"line-height:1.3\"><span style=\"font-size:10.0px;color:#23405A\">class parrot extends bird;  // 派生并重载它</span></p>",
        "align": [
          "left",
          "top"
        ]
      }
