        150
      ],
      "content": {
        "text": "<p style=\"margin-top:0px; line-height:1.45\"><span style=\"font-size:13.0px;color:#44586F;line-height:1.45\">① create 去 factory 的注册表里按类型查记录</span></p><p style=\"margin-top:7px; line-height:1.45\"><span style=\"font-size:13.0px;color:#44586F;line-height:1.45\">② 找到 override 记录，就把请求类型替换掉</span></p><p style=\"margin-top:7px; line-height:1.45\"><span style=\"font-size:13.0px;color:#44586F;line-height:1.45\">③ 用替换后的类型 new 出实例，返回父类句柄</span></p><p style=\"margin-top:7px; line-height:1.45\"><span style=\"font-size:13.0px;color:#44586F;line-height:1.45\">④ 没有记录就按原类型创建</span></p>",
        "align": [
          "left",
          "top"
        ]
      }
