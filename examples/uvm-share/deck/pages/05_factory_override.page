      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:12.0px;color:#8296AA\">// ① 登记一条替换记录：bird → parrot</span></p><p style=\"line-height:1.3\"><span style=\"font-size:12.0px;color:#17754E\">set_type_override_by_type(</span></p><p style=\"line-height:1.3\"><span style=\"font-size:12.0px;color:#23405A\">    bird::get_type(), parrot::get_type());</span></p><p style=\"line-height:1.3\"><span style=\"font-size:12.0px;color:#8296AA\">// ② 创建：源码写 bird，实际造出 parrot</span></p><p style=\"line-height:1.3\"><span style=\"font-size:12.0px;color:#23405A\">bird_inst = bird::type_id::create(\"bird_inst\");</span></p>",
