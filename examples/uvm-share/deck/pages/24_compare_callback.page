      "content": {
        "text": "<p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#8296AA\">// VIP 侧</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">class A extends uvm_callback;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">  virtual task pre_tran(my_driver drv, ref my_transaction tr);</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">endclass</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">typedef uvm_callbacks#(my_driver, A) A_pool;</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">`uvm_register_cb(my_driver, A)</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">`uvm_do_callbacks(my_driver, A, pre_tran(this, req))</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\"></span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#8296AA\">// 用户侧</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">my_cb = my_callback::type_id::create(\"my_cb\");</span></p><p style=\"line-height:1.3\"><span style=\"font-size:11.6px;color:#23405A\">A_pool::add(env.i_agt.drv, my_cb);</span></p>",
        "align": [
          "left",
          "top"
        ]
